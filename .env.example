# Copy to .env and fill in what you have. Everything is optional.
APP_ENV=local
DATABASE_URL=sqlite:///./servicedesk.db

# Optional LLM (otherwise the local rule engine is used)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_KEY=

# Power Automate flow "When an HTTP request is received" URL
POWER_AUTOMATE_WEBHOOK_URL=

# ServiceNow Personal Developer Instance
SERVICENOW_INSTANCE=dev00000.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASSWORD=
